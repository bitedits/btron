%!PS-Adobe-3.0
%%Title: B-System Vector Sample Document
%%Pages: 1
%%EndComments

/TitleFont { /Helvetica-Bold findfont 16 scalefont setfont } def
/SubFont   { /Helvetica findfont 12 scalefont setfont } def
/BodyFont  { /Times-Roman findfont 11 scalefont setfont } def

% Background border
0.5 setlinewidth
0.2 0.4 0.6 setrgbcolor
newpath 50 50 moveto 512 0 rlineto 0 692 rlineto -512 0 rlineto closepath stroke

% Header Banner
0 0 0 setrgbcolor
TitleFont
70 700 moveto (B-System Secure PostScript (sps) Engine) show

SubFont
0.3 0.3 0.3 setrgbcolor
70 680 moveto (Standard PDF 1.4 Vector Rendering & Display Primitives) show

% Draw Coordinate Grid & Diagram Box
0 0 0 setrgbcolor
1.5 setlinewidth
newpath 70 500 moveto 200 0 rlineto 0 140 rlineto -200 0 rlineto closepath stroke

70 500 moveto 270 640 lineto stroke
70 640 moveto 270 500 lineto stroke

TitleFont
0.1 0.5 0.2 setrgbcolor
90 560 moveto (BTRON 3.20) show

% Colored Bezier curves
3.0 setlinewidth
0.8 0.1 0.1 setrgbcolor
newpath 70 400 moveto 150 480 200 320 300 400 curveto stroke

0.1 0.2 0.8 setrgbcolor
newpath 70 380 moveto 150 460 200 300 300 380 curveto stroke

BodyFont
0 0 0 setrgbcolor
70 300 moveto (This document was generated by sps without dynamic scripting.) show
70 280 moveto (Zero JS, zero XFA, pure deterministic archival vector graphics.) show
70 260 moveto (Compatible with BTRON Reader and ISO 32000 PDF viewers.) show

showpage
%%EOF

